{
  "name": "pointr",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:all": "concurrently -n nuxt,party -c green,magenta \"nuxt dev\" \"pnpm dev:party\"",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "typecheck:party": "tsc -p party/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev:party": "wrangler dev --config party/wrangler.jsonc --port 8787",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/vite": "^4.3.2",
    "nanoid": "^5.1.16",
    "nuxt": "^4.4.8",
    "partyserver": "^0.5.8",
    "partysocket": "^1.3.0",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260701.1",
    "@nuxt/eslint": "^1.16.0",
    "@playwright/test": "^1.61.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.6",
    "wrangler": "^4.106.0"
  }
}
